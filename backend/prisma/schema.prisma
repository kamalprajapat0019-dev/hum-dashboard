// Remote MySQL Datasource for OECM Portal

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PM
  AUDITOR
  OPERATIONS
  FINANCE
  CENTRE
}

enum UserStatus {
  Active
  Inactive
  Suspended
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  phoneNumber         String?
  whatsappNumber      String?
  role                Role                 @default(ADMIN)
  avatar              String?              @db.Text
  status              UserStatus           @default(Active)
  scope               Json?                // { clients: string[], projects: string[], centres: string[] }
  managerId           String?
  manager             User?                @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  managedUsers        User[]               @relation("UserManager")
  centreId            String?
  clientId            String?
  emailVerifiedAt     DateTime?
  mobileVerifiedAt    DateTime?
  lastLogin           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  projectsManaged          Project[]
  auditAssignments         AuditAssignment[]
  auditLogs                AuditLog[]
  invitationsSent          UserInvitation[]        @relation("Inviter")
  passwordResetTokens      PasswordResetToken[]
  submoduleReviewsReviewed CentreSubmoduleReview[] @relation("SubmoduleReviewer")
  submoduleReviewsApproved CentreSubmoduleReview[] @relation("SubmodulePmApprover")

  @@index([role, status])
  @@index([managerId])
  @@map("oecm_users")
}

model Client {
  id           String    @id @default(cuid())
  code         String?   @unique
  name         String    // e.g. "NTA"
  fullName     String    // "National Testing Agency"
  contactEmail String
  description  String?   @db.Text
  isActive     Boolean   @default(true)
  status       String    @default("Active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects     Project[]

  @@map("oecm_clients")
}

model Project {
  id              String            @id @default(cuid())
  projectCode     String            @unique // PRJ-001
  name            String            // "NEET UG 2026 – Season 1"
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id])
  examType        String            // "NEET UG", "JEE Mains", etc.
  description     String?           @db.Text
  stage           String            @default("Setup") // Setup, Booking, Document Verification, Audit & Compliance, Allocation, Execution, Closed
  status          String            @default("Active") // Active, OnHold, Completed, Closed
  startDate       DateTime?
  endDate         DateTime?
  examDate        DateTime?
  citiesCount     Int               @default(0)
  candidateTarget Int               @default(0)
  centreTarget    Int               @default(0)
  pmId            String?
  projectManager  User?             @relation(fields: [pmId], references: [id])
  slaHealth       String            @default("OnTrack") // OnTrack, AtRisk, Delayed, Completed
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  bookings        Booking[]
  audits          AuditAssignment[]
  examTypes       ExamType[]
  examDates       ProjectExamDate[]

  @@index([status, stage])
  @@map("oecm_projects")
}

model ProjectExamDate {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  examDate  DateTime
  shift     String   @default("Shift 1")
  startTime String?
  endTime   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, examDate, shift])
  @@index([projectId, examDate])
  @@index([examDate])
  @@map("oecm_project_exam_dates")
}

model ExamType {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  examCode     String
  examTypeName String
  description  String?   @db.Text
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  exams        Exam[]

  @@unique([projectId, examCode])
  @@index([projectId, isActive])
  @@map("oecm_exam_types")
}

model Exam {
  id          String    @id @default(cuid())
  examTypeId  String
  examType    ExamType  @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  examCode    String
  examName    String
  examYear    Int
  description String?   @db.Text
  status      String    @default("Scheduled")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  dates       ExamDate[]
  bookings    Booking[]
  audits      AuditAssignment[]

  @@unique([examTypeId, examCode])
  @@index([examTypeId, status])
  @@map("oecm_exams")
}

model ExamDate {
  id            String      @id @default(cuid())
  examId        String
  exam          Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  examDate      DateTime
  reportingTime String?
  status        String      @default("Scheduled")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  shifts        ExamShift[]

  @@index([examId, examDate])
  @@map("oecm_exam_dates")
}

model ExamShift {
  id            String    @id @default(cuid())
  examDateId    String
  examDate      ExamDate  @relation(fields: [examDateId], references: [id], onDelete: Cascade)
  shiftName     String
  shiftNumber   Int
  startTime     String
  endTime       String
  reportingTime String?
  status        String    @default("Scheduled")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings      Booking[]

  @@index([examDateId, shiftNumber])
  @@map("oecm_exam_shifts")
}

model Centre {
  id                        String                   @id @default(cuid())
  centreCode                String                   @unique // CTR-2026-0001
  userId                    String?
  regionId                  String?
  stateId                   String?
  cityId                    String?
  stateName                 String?
  cityName                  String?
  district                  String?
  taluka                    String?
  eduCode                   String?
  tcCode                    String?
  centreName                String
  centreCategory            String?                  // School, College, University, Government Institution, etc.
  customCentreCategory      String?
  centreAddress             String                   @db.Text
  pincode                   String
  venueStatus               String                   @default("Old") // New, Old
  actualNodes               Int?
  examNodes                 Int?
  previousExamConducted     Boolean                  @default(false)
  previousEduExam           String?                  @db.Text
  previousExamName          String?                  @db.Text
  previousExamDate          DateTime?
  officialEmail             String?
  alternativeEmail          String?
  officialMobile            String?
  whatsappMobile            String?
  alternateMobile           String?
  phoneStd                  String?
  landlineStd               String?
  googleMapLink             String?                  @db.Text
  busStandNearby            Boolean                  @default(false)
  busStandName              String?
  railwayStationNearby      Boolean                  @default(false)
  railwayStationName        String?
  mainRoadDistanceKm        Float?
  signBoardsAvailable       Boolean                  @default(false)
  hotelsNearby              Boolean                  @default(false)
  nearestHotelDistanceKm    Float?
  canteenAvailable          Boolean                  @default(false)
  canteenFoodForStaff       Boolean                  @default(false)
  foodForTestingDays        Boolean                  @default(false)
  foodForMockDays           Boolean                  @default(false)
  outsideFoodPossible       Boolean                  @default(false)
  outsideFoodDetails        String?                  @db.Text
  remarks                   String?                  @db.Text
  centreStatus              String                   @default("Draft") // Draft, Registered, Ready to Book, Invited, Booked, Auditor Assigned, Audited, Allocated, Rejected, Blacklisted
  eligibilityStatus         String                   @default("Eligible") // Eligible, ConditionallyEligible, Ineligible, Blacklisted
  organizationType          String                   @default("Trust") // Individual, Trust, Society, Partnership, Company, Other
  overallSubmodulesVerified Int                      @default(0)
  rejectionReason           String?                  @db.Text
  reworkRemarks             Json?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  contacts                  CentreContact[]
  capacity                  CentreCapacity?
  documents                 CentreDocument[]
  infrastructure            CentreInfrastructure?
  bankAccount               CentreBankAccount?
  bookings                  Booking[]
  audits                    AuditAssignment[]
  blacklists                BlacklistRecord[]
  submoduleReviews          CentreSubmoduleReview[]
  buildings                 CentreBuilding[]
  floors                    CentreFloor[]
  labs                      CentreLab[]
  mediaAssets               CentreMediaAsset[]

  @@index([centreStatus, eligibilityStatus])
  @@index([cityId, stateId])
  @@index([userId])
  @@map("oecm_centres")
}

model CentreSubmoduleReview {
  id             String    @id @default(cuid())
  centreId       String
  centre         Centre    @relation(fields: [centreId], references: [id], onDelete: Cascade)
  submoduleKey   String    // BASIC_INFO, PERSONNEL, DOCUMENTS, BUILDING_INFRA, POWER_NETWORK, BANK_DETAILS
  sectionKey     String    @default("") // Granular sub-section (e.g. "OWNER", "TCA_CS", "LAB_1", "" for whole module)
  status         String    @default("NOT_STARTED") // NOT_STARTED, DRAFT, SUBMITTED, UNDER_AUDIT, PM_REVIEW, REWORK_REQUIRED, VERIFIED
  reworkReason   String?   @db.Text
  reviewedById   String?
  reviewedBy     User?     @relation("SubmoduleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  pmApprovedById String?
  pmApprovedBy   User?     @relation("SubmodulePmApprover", fields: [pmApprovedById], references: [id], onDelete: SetNull)
  pmApprovedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([centreId, submoduleKey, sectionKey])
  @@index([centreId, status])
  @@index([submoduleKey, status])
  @@map("oecm_centre_submodule_reviews")
}

model CentreBuilding {
  id                     String        @id @default(cuid())
  centreId               String
  centre                 Centre        @relation(fields: [centreId], references: [id], onDelete: Cascade)
  buildingOrder          Int           @default(1)
  buildingName           String
  noOfFloors             Int           @default(1)
  entryGateCount         Int           @default(1)
  exitGateCount          Int           @default(1)
  receptionPresent       Boolean       @default(false)
  waitingAreaPresent     Boolean       @default(false)
  drinkingWaterAvailable Boolean       @default(false)
  liftAvailable          Boolean       @default(false)
  noOfLifts              Int           @default(0)
  status                 String        @default("Draft") // Draft, Submitted, Verified, ReworkRequired
  reworkReason           String?       @db.Text
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  floors                 CentreFloor[]
  labs                   CentreLab[]

  @@index([centreId, buildingOrder])
  @@index([centreId, status])
  @@map("oecm_centre_buildings")
}

model CentreFloor {
  id                        String         @id @default(cuid())
  buildingId                String
  building                  CentreBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  centreId                  String
  centre                    Centre         @relation(fields: [centreId], references: [id], onDelete: Cascade)
  floorOrder                Int            @default(1)
  floorName                 String
  noOfLabs                  Int            @default(1)
  washroomsAvailable        Boolean        @default(false)
  totalWashrooms            Int            @default(0)
  maleWashrooms             Int            @default(0)
  femaleWashrooms           Int            @default(0)
  drinkingWaterAvailable    Boolean        @default(false)
  acAvailable               Boolean        @default(false)
  sufficientFans            Boolean        @default(false)
  fireExtinguisherAvailable Boolean        @default(false)
  cctvCoverage              Boolean        @default(false)
  pwdAccessible             Boolean        @default(false)
  rampOrLiftAccess          Boolean        @default(false)
  pwdWashroomAvailable      Boolean        @default(false)
  status                    String         @default("Draft") // Draft, Submitted, Verified, ReworkRequired
  reworkReason              String?        @db.Text
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  labs                      CentreLab[]

  @@index([buildingId, floorOrder])
  @@index([centreId, status])
  @@map("oecm_centre_floors")
}

model CentreLab {
  id                         String         @id @default(cuid())
  floorId                    String
  floor                      CentreFloor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  buildingId                 String
  building                   CentreBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  centreId                   String
  centre                     Centre         @relation(fields: [centreId], references: [id], onDelete: Cascade)
  labOrder                   Int            @default(1)
  labName                    String
  labType                    String         @default("Dedicated CBT Lab")
  customLabType              String?
  totalNodes                 Int            @default(0)
  examNodes                  Int            @default(0)
  workingNodes               Int            @default(0)
  pwdSuitable                Boolean        @default(false)
  adjacentComputerDistanceFt Float?
  partitionAvailable         Boolean        @default(false)
  partitionType              String?
  systemOwnership            String         @default("Owned") // Owned, Leased, Rented
  systemOwnershipRemarks     String?        @db.Text
  renovationPlanned          Boolean        @default(false)
  renovationStartDate        DateTime?
  renovationEndDate          DateTime?
  renovationRemarks          String?        @db.Text
  canFormatSystems           Boolean        @default(false)
  canChangeIp                Boolean        @default(false)
  canChangeSystemNames       Boolean        @default(false)
  internetAvailable          Boolean        @default(false)
  upsAvailable               Boolean        @default(false)
  upsCapacityKva             Float?
  printerAvailable           Boolean        @default(false)
  biometricAvailable         Boolean        @default(false)
  cctvAvailable              Boolean        @default(false)
  cctvCount                  Int            @default(0)
  jammerInstallable          Boolean        @default(false)
  seatingType                String?
  candidateDeskAvailable     Boolean        @default(false)
  candidateChairAvailable    Boolean        @default(false)
  invigilatorSeatAvailable   Boolean        @default(false)
  whiteboardAvailable        Boolean        @default(false)
  fireExtinguisherAvailable  Boolean        @default(false)
  emergencyExitAvailable     Boolean        @default(false)
  emergencySignageAvailable  Boolean        @default(false)
  firstAidAvailable          Boolean        @default(false)
  status                     String         @default("Draft") // Draft, Submitted, Verified, ReworkRequired
  reworkReason               String?        @db.Text
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@index([floorId, labOrder])
  @@index([buildingId])
  @@index([centreId, status])
  @@map("oecm_centre_labs")
}

model CentreMediaAsset {
  id                String    @id @default(cuid())
  centreId          String
  centre            Centre    @relation(fields: [centreId], references: [id], onDelete: Cascade)
  entityType        String    // CENTRE, CONTACT, DOCUMENT, BUILDING, FLOOR, LAB, POWER_NETWORK, BANK
  entityId          String    // ID of target entity
  fieldKey          String    // e.g. "building_front_photo", "lab_panoramic_photo", "cancelled_cheque"
  assetCategory     String    @default("PHOTO") // PHOTO, DOCUMENT
  fileName          String
  fileUrl           String    @db.LongText
  storageProvider   String    @default("local") // local, s3, gcs, r2
  storageKey        String?
  mimeType          String
  originalSizeBytes Int       @default(0)
  finalSizeBytes    Int       @default(0)
  isCompressed      Boolean   @default(false)
  version           Int       @default(1)
  isActive          Boolean   @default(true)
  replacedById      String?
  uploadedById      String?
  status            String    @default("Pending") // Pending, Verified, Rejected, ReworkRequired
  reworkReason      String?   @db.Text
  remarks           String?   @db.Text
  verifiedAt        DateTime?
  verifiedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([centreId, entityType, entityId])
  @@index([centreId, fieldKey])
  @@index([centreId, status])
  @@index([storageProvider, storageKey])
  @@index([centreId, createdAt])
  @@map("oecm_centre_media_assets")
}

model CentreDocument {
  id                String    @id @default(cuid())
  centreId          String
  centre            Centre    @relation(fields: [centreId], references: [id], onDelete: Cascade)
  documentType      String    // owner_id_proof, mou, nda, pan, gst, etc.
  documentName      String
  fileName          String
  fileUrl           String    @db.LongText
  fileSize          Int       @default(0)
  mimeType          String    @default("application/pdf")
  status            String    @default("Pending") // Pending, Verified, Rejected, ReworkRequired
  rejectionReason   String?   @db.Text
  remarks           String?   @db.Text
  version           Int       @default(1)
  storageProvider   String    @default("local") // local, s3, gcs, r2
  storageKey        String?
  originalSizeBytes Int       @default(0)
  finalSizeBytes    Int       @default(0)
  isCompressed      Boolean   @default(false)
  isActive          Boolean   @default(true)
  replacedById      String?
  uploadedById      String?
  verifiedAt        DateTime?
  verifiedBy        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([centreId, documentType])
  @@index([centreId, status])
  @@index([storageProvider, storageKey])
  @@map("oecm_centre_documents")
}

model CentreInfrastructure {
  id                             String    @id @default(cuid())
  centreId                       String    @unique
  centre                         Centre    @relation(fields: [centreId], references: [id], onDelete: Cascade)

  // Transport & Accessibility (Step 1 & 4)
  busStandNearby                 Boolean   @default(false)
  busStandName                   String?
  metroNearby                    Boolean   @default(false)
  metroStationName               String?
  distanceFromMainRoad           Float?
  signBoards                     Boolean   @default(false)
  printerAvailable               Boolean   @default(false)
  jammerAvailable                Boolean   @default(false)
  phFriendly                     Boolean   @default(false)
  phCandidateCount               Int?
  elevatorAvailable              Boolean   @default(false)
  wheelchairAvailable            Boolean   @default(false)

  // Building & Facilities (Step 4)
  noOfFloors                     Int       @default(1)
  buildingType                   String?
  specifiedBuildingType          String?
  noOfLifts                      Int       @default(0)
  noOfEntryGates                 Int       @default(1)
  noOfExitGates                  Int       @default(1)
  buildingNameWing               String?
  floorBuildingDetails           String?   @db.Text
  washroomsEachFloor             Int       @default(1)
  maleWashroomsEachFloor         Int       @default(1)
  femaleWashroomsEachFloor       Int       @default(1)
  noOfCctvCameras                Int       @default(0)
  cctvAreas                      Json?
  drinkingWaterArea              String?
  parkingAvailable               Boolean   @default(false)
  candidateParkingInside         Boolean   @default(false)
  receptionArea                  Boolean   @default(false)
  waitingArea                    Boolean   @default(false)
  maleWashroom                   Boolean   @default(false)
  femaleWashroom                 Boolean   @default(false)
  separateWashrooms              Boolean   @default(false)
  drinkingWater                  Boolean   @default(false)
  acAvailable                    Boolean   @default(false)
  lockerFacility                 Boolean   @default(false)
  separateEntryExit              Boolean   @default(false)
  suitablePwd                    Boolean   @default(false)
  rampFacility                   Boolean   @default(false)
  railingSupport                 Boolean   @default(false)
  cctvLobby                      Boolean   @default(false)
  serverRoomAvailable            Boolean   @default(false)
  acInServerRoom                 Boolean   @default(false)
  serverRoomUpsNetwork           Boolean   @default(false)
  dedicatedServerRoom            Boolean   @default(false)

  // Extended Power & Generators (Step 5)
  electricityProvider            String?
  connectionType                 String?
  sanctionedLoadKw               Float?
  avgMonthlyKwh                  Float?
  upsAvailable                   Boolean   @default(false)
  upsCapacityKva                 Float?
  upsModel                       String?
  upsBackupDurationMins          Int?
  gensetAvailable                Boolean   @default(false)
  gensetCapacityKva              Float?
  generatorFuelType              String?
  generatorModel                 String?
  generatorAutoSwitchover        Boolean   @default(false)
  backupGensetAvailable          Boolean   @default(false)
  backupGensetCapacityKva        Float?
  backupGeneratorFuelType        String?
  backupGeneratorModel           String?
  electricianAvailableOnsite     Boolean   @default(false)
  electricianArrangementSlaHours Int?

  // Extended Network & LAN (Step 5)
  coreSwitch1Gbps                Boolean   @default(false)
  primaryInternet                Boolean   @default(false)
  backupInternet                 Boolean   @default(false)
  primaryIspName                 String?
  primaryIspBandwidthMbps        Float?
  secondaryIspName               String?
  secondaryIspBandwidthMbps      Float?
  backupDonglesAvailable         Boolean   @default(false)
  backupDonglesCount             Int?
  backupDonglesDetails           String?
  networkAdminsCount             Int       @default(0)
  networkAdminsDetails           Json?
  spareHardwareItems             Json?
  spareArrangementTimeHours      Int?
  switchType                     String?
  ipScanningAvailable            Boolean   @default(false)
  networkDiagramAvailable        Boolean   @default(false)
  lanType                        String?

  // Safety & Security & Medical (Step 6)
  noOfFireExtinguishers          Int       @default(0)
  fireSafetyClearanceDate        DateTime?
  fireExtinguisherRefillDate     DateTime?
  firstAidKit                    Boolean   @default(false)
  fireExtinguisherEachFloor      Boolean   @default(false)
  fireEmergencyAccessible        Boolean   @default(false)
  assemblyArea                   Boolean   @default(false)
  safetySignage                  Boolean   @default(false)
  safeArea                       Boolean   @default(false)
  safeLateHours                  Boolean   @default(false)
  adequateHygiene                Boolean   @default(false)
  insuranceCoverage              Boolean   @default(false)
  medicalFacilityNearby          Boolean   @default(false)
  nearestHospitalDistanceKm      Float?
  doctorOnCall                   Boolean   @default(false)
  ambulanceContactNumber         String?
  reworkRemarks                  Json?

  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  @@map("oecm_centre_infrastructures")
}

model CentreBankAccount {
  id                 String    @id @default(cuid())
  centreId           String    @unique
  centre             Centre    @relation(fields: [centreId], references: [id], onDelete: Cascade)
  accountName        String
  bankName           String
  branchName         String
  accountNumber      String
  ifscCode           String
  accountType        String    @default("Current Account")
  branchAddress      String?   @db.Text
  cancelledChequeUrl String?   @db.LongText
  passbookUrl        String?   @db.LongText
  verificationStatus String    @default("Submitted") // Not Submitted, Submitted, Pending Verification, Verified, Rejected, Re-verification Required
  rejectionReason    String?   @db.Text
  remarks            String?   @db.Text
  isPaymentEligible  Boolean   @default(false)
  beneficiaryMatched Boolean   @default(false)
  verifiedAt         DateTime?
  verifiedBy         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("oecm_centre_bank_accounts")
}

model CentreContact {
  id                     String   @id @default(cuid())
  centreId               String
  centre                 Centre   @relation(fields: [centreId], references: [id], onDelete: Cascade)
  personType             String   // Owner, TCA, IT Person, Electrician, Centre Head / Venue CS, OWNER, TCA_CS, IT_PERSON, ELECTRICIAN
  fullName               String
  contactNumber          String
  alternateContactNumber String?
  whatsappNumber         String?
  email                  String?
  aadhaarNumber          String?
  panNumber              String?
  fatherName             String?
  motherName             String?
  permanentAddress       String?  @db.Text
  currentAddress         String?  @db.Text
  qualification          String?
  experienceYears        Int?
  isCertified            Boolean?
  isPrimary              Boolean  @default(false)
  isActive               Boolean  @default(true)
  status                 String   @default("Draft") // Draft, Submitted, Verified, ReworkRequired
  reworkReason           String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([centreId, personType])
  @@index([centreId, status])
  @@map("oecm_centre_contacts")
}

model CentreCapacity {
  id               String   @id @default(cuid())
  centreId         String   @unique
  centre           Centre   @relation(fields: [centreId], references: [id], onDelete: Cascade)
  totalSystems     Int      @default(0)
  examNodes        Int      @default(0)
  bufferPercent    Float    @default(10.0)
  regDeskCount     Int      @default(2)
  serverCount      Int      @default(1)
  networkSpeedMbps Float    @default(100.0)
  upsCapacityKva   Float    @default(10.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("oecm_centre_capacities")
}

model Booking {
  id            String     @id @default(cuid())
  bookingCode   String     @unique
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id])
  centreId      String
  centre        Centre     @relation(fields: [centreId], references: [id])
  examId        String?
  exam          Exam?      @relation(fields: [examId], references: [id])
  examShiftId   String?
  examShift     ExamShift? @relation(fields: [examShiftId], references: [id])
  dates         Json       // array of dates
  shiftsCount   Int        @default(1)
  systemsBooked Int        @default(0)
  status        String     @default("Draft") // Draft, Requested, Confirmed, Cancelled
  isLocked      Boolean    @default(false)
  lockReason    String?
  lockedBy      String?
  lockedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([projectId, centreId])
  @@index([examId])
  @@map("oecm_bookings")
}

model AuditAssignment {
  id               String    @id @default(cuid())
  assignmentCode   String    @unique
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id])
  centreId         String
  centre           Centre    @relation(fields: [centreId], references: [id])
  examId           String?
  exam             Exam?     @relation(fields: [examId], references: [id])
  auditorId        String?
  auditor          User?     @relation(fields: [auditorId], references: [id])
  auditDate        DateTime?
  status           String    @default("Pending") // Pending, Assigned, InProgress, Completed, ReworkRequired, Failed
  complianceScore  Float?
  findingsSummary  String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId, centreId, auditorId])
  @@index([examId])
  @@map("oecm_audit_assignments")
}

model BlacklistRecord {
  id             String    @id @default(cuid())
  centreId       String
  centre         Centre    @relation(fields: [centreId], references: [id], onDelete: Cascade)
  reason         String    @db.Text // Confidential reason
  flaggedBy      String
  isActive       Boolean   @default(true)
  overrideReason String?   @db.Text
  overriddenBy   String?
  overriddenAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([centreId, isActive])
  @@map("oecm_blacklist_records")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userEmail String?
  action    String   // e.g. "USER_CREATED", "USER_UPDATED", "CENTRE_APPROVED", "PROJECT_STAGE_UPDATED"
  entity    String   // "User", "Centre", "Project", "SystemConfig", "Booking"
  entityId  String?
  details   Json?    // Contextual payload / differences
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("oecm_audit_logs")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String   @default("GENERAL") // GENERAL, SECURITY, NOTIFICATION, COMPLIANCE
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("oecm_system_configs")
}

model UserInvitation {
  id               String    @id @default(cuid())
  email            String
  name             String
  role             Role
  phone            String?
  whatsappNumber   String?
  clientId         String?
  centreId         String?
  scope            Json?
  token            String    @unique
  expiresAt        DateTime  // 72-hour window
  status           String    @default("Pending") // Pending, Accepted, Expired, Revoked
  inviterId        String
  inviter          User      @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  acceptedAt       DateTime?
  usedAt           DateTime?
  emailVerifiedAt  DateTime?
  mobileVerifiedAt DateTime?
  resendCount      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([email])
  @@index([token])
  @@index([inviterId])
  @@index([status, expiresAt])
  @@map("oecm_user_invitations")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@map("oecm_password_reset_tokens")
}

model AllowedEmailDomain {
  id        String   @id @default(cuid())
  domain    String   @unique // e.g. "oemportal.in", "assessinfra.com"
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("oecm_allowed_email_domains")
}
