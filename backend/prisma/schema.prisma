// Remote MySQL Datasource for OECM Portal

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PM
  AUDITOR
  OPERATIONS
  FINANCE
  CENTRE
}

enum UserStatus {
  Active
  Inactive
  Suspended
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             Role              @default(ADMIN)
  avatar           String?           @db.Text
  status           UserStatus        @default(Active)
  scope            Json?             // { clients: string[], projects: string[], centres: string[] }
  lastLogin        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  projectsManaged  Project[]
  auditAssignments AuditAssignment[]
  auditLogs        AuditLog[]

  @@index([role, status])
  @@map("oecm_users")
}

model Client {
  id           String    @id @default(cuid())
  code         String?   @unique
  name         String    // e.g. "NTA"
  fullName     String    // "National Testing Agency"
  contactEmail String
  description  String?   @db.Text
  isActive     Boolean   @default(true)
  status       String    @default("Active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects     Project[]

  @@map("oecm_clients")
}

model Project {
  id              String            @id @default(cuid())
  projectCode     String            @unique // PRJ-001
  name            String            // "NEET UG 2026 – Season 1"
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id])
  examType        String            // "NEET UG", "JEE Mains", etc.
  description     String?           @db.Text
  stage           String            @default("Setup") // Setup, Booking, Document Verification, Audit & Compliance, Allocation, Execution, Closed
  status          String            @default("Active") // Active, OnHold, Completed, Closed
  startDate       DateTime?
  endDate         DateTime?
  examDate        DateTime?
  citiesCount     Int               @default(0)
  candidateTarget Int               @default(0)
  centreTarget    Int               @default(0)
  pmId            String?
  projectManager  User?             @relation(fields: [pmId], references: [id])
  slaHealth       String            @default("OnTrack") // OnTrack, AtRisk, Delayed, Completed
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  bookings        Booking[]
  audits          AuditAssignment[]
  examTypes       ExamType[]
  examDates       ProjectExamDate[]

  @@index([status, stage])
  @@map("oecm_projects")
}

model ProjectExamDate {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  examDate  DateTime
  shift     String   @default("Shift 1")
  startTime String?
  endTime   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, examDate, shift])
  @@index([projectId, examDate])
  @@index([examDate])
  @@map("oecm_project_exam_dates")
}

model ExamType {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  examCode     String
  examTypeName String
  description  String?   @db.Text
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  exams        Exam[]

  @@unique([projectId, examCode])
  @@index([projectId, isActive])
  @@map("oecm_exam_types")
}

model Exam {
  id          String    @id @default(cuid())
  examTypeId  String
  examType    ExamType  @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  examCode    String
  examName    String
  examYear    Int
  description String?   @db.Text
  status      String    @default("Scheduled")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  dates       ExamDate[]
  bookings    Booking[]
  audits      AuditAssignment[]

  @@unique([examTypeId, examCode])
  @@index([examTypeId, status])
  @@map("oecm_exams")
}

model ExamDate {
  id            String      @id @default(cuid())
  examId        String
  exam          Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  examDate      DateTime
  reportingTime String?
  status        String      @default("Scheduled")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  shifts        ExamShift[]

  @@index([examId, examDate])
  @@map("oecm_exam_dates")
}

model ExamShift {
  id            String    @id @default(cuid())
  examDateId    String
  examDate      ExamDate  @relation(fields: [examDateId], references: [id], onDelete: Cascade)
  shiftName     String
  shiftNumber   Int
  startTime     String
  endTime       String
  reportingTime String?
  status        String    @default("Scheduled")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings      Booking[]

  @@index([examDateId, shiftNumber])
  @@map("oecm_exam_shifts")
}

model Centre {
  id                    String                @id @default(cuid())
  centreCode            String                @unique // CTR-2026-0001
  userId                String?
  regionId              String?
  stateId               String?
  cityId                String?
  stateName             String?
  cityName              String?
  taluka                String?
  eduCode               String?
  tcCode                String?
  centreName            String
  centreCategory        String?               // School, College, University, Government Institution, etc.
  centreAddress         String                @db.Text
  pincode               String
  venueStatus           String                @default("Old") // New, Old
  previousExamConducted Boolean               @default(false)
  previousEduExam       String?               @db.Text
  officialEmail         String?
  officialMobile        String?
  alternateMobile       String?
  phoneStd              String?
  googleMapLink         String?               @db.Text
  remarks               String?               @db.Text
  centreStatus          String                @default("Draft") // Draft, Registered, Ready to Book, Invited, Booked, Auditor Assigned, Audited, Allocated, Rejected, Blacklisted
  eligibilityStatus     String                @default("Eligible") // Eligible, ConditionallyEligible, Ineligible, Blacklisted
  organizationType      String                @default("Trust") // Individual, Trust, Society, Partnership, Company, Other
  rejectionReason       String?               @db.Text
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  contacts              CentreContact[]
  capacity              CentreCapacity?
  documents             CentreDocument[]
  infrastructure        CentreInfrastructure?
  bankAccount           CentreBankAccount?
  bookings              Booking[]
  audits                AuditAssignment[]
  blacklists            BlacklistRecord[]

  @@index([centreStatus, eligibilityStatus])
  @@index([cityId, stateId])
  @@index([userId])
  @@map("oecm_centres")
}

model CentreDocument {
  id              String    @id @default(cuid())
  centreId        String
  centre          Centre    @relation(fields: [centreId], references: [id], onDelete: Cascade)
  documentType    String    // owner_id_proof, mou, nda, pan, gst, etc.
  documentName    String
  fileName        String
  fileUrl         String    @db.LongText
  fileSize        Int       @default(0)
  mimeType        String    @default("application/pdf")
  status          String    @default("Pending") // Pending, Verified, Rejected
  rejectionReason String?   @db.Text
  remarks         String?   @db.Text
  version         Int       @default(1)
  verifiedAt      DateTime?
  verifiedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([centreId, documentType])
  @@map("oecm_centre_documents")
}

model CentreInfrastructure {
  id                       String   @id @default(cuid())
  centreId                 String   @unique
  centre                   Centre   @relation(fields: [centreId], references: [id], onDelete: Cascade)

  // Transport & Accessibility (Step 1 & 4)
  busStandNearby           Boolean  @default(false)
  busStandName             String?
  metroNearby              Boolean  @default(false)
  metroStationName         String?
  distanceFromMainRoad     Float?
  signBoards               Boolean  @default(false)
  printerAvailable         Boolean  @default(false)
  jammerAvailable          Boolean  @default(false)
  phFriendly               Boolean  @default(false)
  phCandidateCount         Int?
  elevatorAvailable        Boolean  @default(false)
  wheelchairAvailable      Boolean  @default(false)

  // Building & Facilities (Step 4)
  noOfFloors               Int      @default(1)
  buildingType             String?
  specifiedBuildingType    String?
  noOfLifts                Int      @default(0)
  noOfEntryGates           Int      @default(1)
  noOfExitGates            Int      @default(1)
  buildingNameWing         String?
  floorBuildingDetails     String?  @db.Text
  washroomsEachFloor       Int      @default(1)
  maleWashroomsEachFloor   Int      @default(1)
  femaleWashroomsEachFloor Int      @default(1)
  noOfCctvCameras          Int      @default(0)
  cctvAreas                Json?
  drinkingWaterArea        String?
  parkingAvailable         Boolean  @default(false)
  candidateParkingInside   Boolean  @default(false)
  receptionArea            Boolean  @default(false)
  waitingArea              Boolean  @default(false)
  maleWashroom             Boolean  @default(false)
  femaleWashroom           Boolean  @default(false)
  separateWashrooms        Boolean  @default(false)
  drinkingWater            Boolean  @default(false)
  acAvailable              Boolean  @default(false)
  lockerFacility           Boolean  @default(false)
  separateEntryExit        Boolean  @default(false)
  suitablePwd              Boolean  @default(false)
  rampFacility             Boolean  @default(false)
  railingSupport           Boolean  @default(false)
  cctvLobby                Boolean  @default(false)
  serverRoomAvailable      Boolean  @default(false)
  acInServerRoom           Boolean  @default(false)
  serverRoomUpsNetwork     Boolean  @default(false)
  dedicatedServerRoom      Boolean  @default(false)

  // Power & Network (Step 5)
  upsAvailable             Boolean  @default(false)
  upsCapacityKva           Float?
  gensetAvailable          Boolean  @default(false)
  gensetCapacityKva        Float?
  backupGensetAvailable    Boolean  @default(false)
  backupGensetCapacityKva  Float?
  coreSwitch1Gbps          Boolean  @default(false)
  primaryInternet          Boolean  @default(false)
  backupInternet           Boolean  @default(false)
  ipScanningAvailable      Boolean  @default(false)
  networkDiagramAvailable  Boolean  @default(false)
  lanType                  String?

  // Safety & Security (Step 6)
  noOfFireExtinguishers    Int      @default(0)
  fireSafetyClearanceDate  DateTime?
  fireExtinguisherRefillDate DateTime?
  firstAidKit              Boolean  @default(false)
  fireExtinguisherEachFloor Boolean @default(false)
  fireEmergencyAccessible  Boolean  @default(false)
  assemblyArea             Boolean  @default(false)
  safetySignage            Boolean  @default(false)
  safeArea                 Boolean  @default(false)
  safeLateHours            Boolean  @default(false)
  adequateHygiene          Boolean  @default(false)
  insuranceCoverage        Boolean  @default(false)

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("oecm_centre_infrastructures")
}

model CentreBankAccount {
  id                 String    @id @default(cuid())
  centreId           String    @unique
  centre             Centre    @relation(fields: [centreId], references: [id], onDelete: Cascade)
  accountName        String
  bankName           String
  branchName         String
  accountNumber      String
  ifscCode           String
  accountType        String    @default("Current Account")
  branchAddress      String?   @db.Text
  cancelledChequeUrl String?   @db.LongText
  passbookUrl        String?   @db.LongText
  verificationStatus String    @default("Submitted") // Not Submitted, Submitted, Pending Verification, Verified, Rejected, Re-verification Required
  rejectionReason    String?   @db.Text
  remarks            String?   @db.Text
  isPaymentEligible  Boolean   @default(false)
  beneficiaryMatched Boolean   @default(false)
  verifiedAt         DateTime?
  verifiedBy         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("oecm_centre_bank_accounts")
}

model CentreContact {
  id               String   @id @default(cuid())
  centreId         String
  centre           Centre   @relation(fields: [centreId], references: [id], onDelete: Cascade)
  personType       String   // Owner, TCA, IT Person, Electrician, Centre Head / Venue CS
  fullName         String
  contactNumber    String
  email            String?
  aadhaarNumber    String?
  fatherName       String?
  motherName       String?
  permanentAddress String?  @db.Text
  currentAddress   String?  @db.Text
  isPrimary        Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([centreId, personType])
  @@map("oecm_centre_contacts")
}

model CentreCapacity {
  id               String   @id @default(cuid())
  centreId         String   @unique
  centre           Centre   @relation(fields: [centreId], references: [id], onDelete: Cascade)
  totalSystems     Int      @default(0)
  examNodes        Int      @default(0)
  bufferPercent    Float    @default(10.0)
  regDeskCount     Int      @default(2)
  serverCount      Int      @default(1)
  networkSpeedMbps Float    @default(100.0)
  upsCapacityKva   Float    @default(10.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("oecm_centre_capacities")
}

model Booking {
  id            String     @id @default(cuid())
  bookingCode   String     @unique
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id])
  centreId      String
  centre        Centre     @relation(fields: [centreId], references: [id])
  examId        String?
  exam          Exam?      @relation(fields: [examId], references: [id])
  examShiftId   String?
  examShift     ExamShift? @relation(fields: [examShiftId], references: [id])
  dates         Json       // array of dates
  shiftsCount   Int        @default(1)
  systemsBooked Int        @default(0)
  status        String     @default("Draft") // Draft, Requested, Confirmed, Cancelled
  isLocked      Boolean    @default(false)
  lockReason    String?
  lockedBy      String?
  lockedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([projectId, centreId])
  @@index([examId])
  @@map("oecm_bookings")
}

model AuditAssignment {
  id               String    @id @default(cuid())
  assignmentCode   String    @unique
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id])
  centreId         String
  centre           Centre    @relation(fields: [centreId], references: [id])
  examId           String?
  exam             Exam?     @relation(fields: [examId], references: [id])
  auditorId        String?
  auditor          User?     @relation(fields: [auditorId], references: [id])
  auditDate        DateTime?
  status           String    @default("Pending") // Pending, Assigned, InProgress, Completed, ReworkRequired, Failed
  complianceScore  Float?
  findingsSummary  String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId, centreId, auditorId])
  @@index([examId])
  @@map("oecm_audit_assignments")
}

model BlacklistRecord {
  id             String    @id @default(cuid())
  centreId       String
  centre         Centre    @relation(fields: [centreId], references: [id], onDelete: Cascade)
  reason         String    @db.Text // Confidential reason
  flaggedBy      String
  isActive       Boolean   @default(true)
  overrideReason String?   @db.Text
  overriddenBy   String?
  overriddenAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([centreId, isActive])
  @@map("oecm_blacklist_records")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userEmail String?
  action    String   // e.g. "USER_CREATED", "USER_UPDATED", "CENTRE_APPROVED", "PROJECT_STAGE_UPDATED"
  entity    String   // "User", "Centre", "Project", "SystemConfig", "Booking"
  entityId  String?
  details   Json?    // Contextual payload / differences
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("oecm_audit_logs")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String   @default("GENERAL") // GENERAL, SECURITY, NOTIFICATION, COMPLIANCE
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("oecm_system_configs")
}
