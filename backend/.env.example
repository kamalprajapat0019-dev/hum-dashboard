# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Neon Cloud PostgreSQL Connection
# Pooled connection string for queries
DATABASE_URL="postgresql://user:password@ep-something-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection string for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-something.region.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="8h"

# Initial Admin Setup Seed (Used only by seed script, never committed with real values)
INITIAL_ADMIN_EMAIL="admin@oemportal.in"
INITIAL_ADMIN_PASSWORD="replace-with-secure-initial-password"
INITIAL_ADMIN_NAME="System Administrator"
