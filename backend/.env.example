# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Remote MySQL Connection
DB_HOST=82.29.160.161
DB_PORT=3306
DB_NAME=hum_database
DB_USER=admin_user
DB_PASSWORD=your_mysql_password_here

# Prisma Database Connection URL
DATABASE_URL="mysql://admin_user:your_encoded_password@82.29.160.161:3306/hum_database"

# JWT Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="8h"

# Initial Admin Setup Seed (Used only by seed script, never committed with real values)
INITIAL_ADMIN_EMAIL="admin@oemportal.in"
INITIAL_ADMIN_PASSWORD="replace-with-secure-initial-password"
INITIAL_ADMIN_NAME="System Administrator"
